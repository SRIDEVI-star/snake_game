<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Snake</title>
<style>
:root{--bg:#10231b;--panel:#17362a;--grid:#1c4032;--snake:#b8e986;--head:#eaffc4;--food:#ff6b57;--text:#e6f2e9;--muted:#8fb09c;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root[data-theme="light"]{--bg:#e8f1e4;--panel:#d5e6cf;--grid:#c3dbbc;--snake:#2f7d3a;--head:#1b5e27;--food:#d9432f;--text:#173222;--muted:#4b6b57}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#e8f1e4;--panel:#d5e6cf;--grid:#c3dbbc;--snake:#2f7d3a;--head:#1b5e27;--food:#d9432f;--text:#173222;--muted:#4b6b57}}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--text);font-family:Georgia,"Times New Roman",serif;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:12px;touch-action:manipulation}
h1{margin:0;font-size:2rem;font-weight:700;letter-spacing:.02em}
.bar{display:flex;gap:24px;color:var(--muted);font-size:1.05rem}
.bar b{color:var(--text);font-variant-numeric:tabular-nums}
.wrap{position:relative;width:min(92vw,420px);aspect-ratio:1}
canvas{width:100%;height:100%;display:block;border-radius:10px;background:var(--panel);box-shadow:0 0 0 3px var(--grid)}
.overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:color-mix(in srgb,var(--bg) 82%,transparent);border-radius:10px;text-align:center;padding:16px}
.overlay.hide{display:none}
button{font:inherit;font-size:1.05rem;padding:10px 22px;border-radius:8px;border:0;background:var(--snake);color:var(--bg);cursor:pointer}
button:focus-visible{outline:3px solid var(--text);outline-offset:2px}
.hint{color:var(--muted);font-size:.95rem;max-width:30ch}
.pad{display:grid;grid-template-columns:repeat(3,56px);grid-template-rows:repeat(2,56px);gap:8px}
.pad button{padding:0;font-size:1.4rem;background:var(--panel);color:var(--text)}
.pad .u{grid-column:2}.pad .l{grid-column:1;grid-row:2}.pad .d{grid-column:2;grid-row:2}.pad .r{grid-column:3;grid-row:2}
@media (hover:hover) and (pointer:fine){.pad{display:none}}
</style>
</head>
<body>
<h1>Snake</h1>
<div class="bar"><span>Score <b id="score">0</b></span><span>Best <b id="best">0</b></span></div>
<div class="wrap">
  <canvas id="c" width="420" height="420" aria-label="Snake game board"></canvas>
  <div class="overlay" id="ov">
    <div id="msg" style="font-size:1.4rem">Ready?</div>
    <div class="hint" id="sub">Arrow keys or WASD to steer. Space pauses.</div>
    <button id="go">Start game</button>
  </div>
</div>
<div class="pad" aria-label="Touch controls">
  <button class="u" data-d="U" aria-label="Up">▲</button>
  <button class="l" data-d="L" aria-label="Left">◀</button>
  <button class="d" data-d="D" aria-label="Down">▼</button>
  <button class="r" data-d="R" aria-label="Right">▶</button>
</div>
<script>
const N=21, cv=document.getElementById('c'), ctx=cv.getContext('2d'), S=cv.width/N;
const $=id=>document.getElementById(id);
const dirs={U:[0,-1],D:[0,1],L:[-1,0],R:[1,0]};
let snake,dir,next,food,score,best=0,timer,running=false,paused=false;
try{best=+localStorage.getItem('snake-best')||0}catch(e){}
$('best').textContent=best;
 
function css(v){return getComputedStyle(document.documentElement).getPropertyValue(v).trim()}
function reset(){
  snake=[[10,10],[9,10],[8,10]];dir='R';next='R';score=0;$('score').textContent=0;placeFood();
}
function placeFood(){
  do{food=[Math.floor(Math.random()*N),Math.floor(Math.random()*N)]}
  while(snake.some(s=>s[0]===food[0]&&s[1]===food[1]));
}
function speed(){return Math.max(60,130-score*3)}
function start(){
  reset();running=true;paused=false;$('ov').classList.add('hide');
  clearTimeout(timer);draw();timer=setTimeout(tick,speed());
}
function tick(){
  if(!running||paused)return;
  dir=next;const d=dirs[dir];
  const h=[snake[0][0]+d[0],snake[0][1]+d[1]];
  if(h[0]<0||h[1]<0||h[0]>=N||h[1]>=N||snake.some(s=>s[0]===h[0]&&s[1]===h[1]))return over();
  snake.unshift(h);
  if(h[0]===food[0]&&h[1]===food[1]){score++;$('score').textContent=score;placeFood()}
  else snake.pop();
  draw();timer=setTimeout(tick,speed());
}
function over(){
  running=false;
  if(score>best){best=score;$('best').textContent=best;try{localStorage.setItem('snake-best',best)}catch(e){}}
  $('msg').textContent='Game over';
  $('sub').textContent='You scored '+score+'. Hit the wall or yourself.';
  $('go').textContent='Play again';$('ov').classList.remove('hide');
}
function draw(){
  ctx.clearRect(0,0,cv.width,cv.height);
  ctx.fillStyle=css('--grid');
  for(let x=0;x<N;x++)for(let y=0;y<N;y++)if((x+y)%2===0)ctx.fillRect(x*S,y*S,S,S);
  ctx.f
  
